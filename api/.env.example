# Primary model ("provider:model") and its API key
TERMSNAP_LLM_T1=ollama:gemma4:31b-cloud
TERMSNAP_LLM_T1_KEY=
# Fallback model, used automatically if the primary fails
TERMSNAP_LLM_T2=google_genai:gemini-3.8-flash
TERMSNAP_LLM_T2_KEY=
# Comma-separated origins allowed to call the API
TERMSNAP_CORS_ORIGINS=http://localhost:3000
